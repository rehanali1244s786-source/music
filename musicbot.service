# Install:  sudo cp musicbot.service /etc/systemd/system/
#           (edit User and paths below first)
#           sudo systemctl daemon-reload && sudo systemctl enable --now musicbot
[Unit]
Description=Telegram Music Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/musicbot
ExecStart=/home/ubuntu/musicbot/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
